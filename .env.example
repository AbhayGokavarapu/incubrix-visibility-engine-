# IncuBrix Visibility Engine Environment Configuration Example
# Copy this file to .env and configure your authorized API keys.
# DO NOT COMMIT .env TO VERSION CONTROL.

# -----------------------------------------------------------------
# 1. Google Custom Search JSON API (Official Organic SERP Data)
# Docs: https://developers.google.com/custom-search/v1/overview
# -----------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Alternative permitted search provider (SerpAPI):
SERPAPI_API_KEY=

# -----------------------------------------------------------------
# 2. OpenAI API (ChatGPT Family - gpt-4o / gpt-4o-mini with Search)
# Docs: https://platform.openai.com/docs/api-reference
# -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------
# 3. Google Gemini API (gemini-1.5-pro / gemini-1.5-flash with Grounding)
# Docs: https://ai.google.dev/gemini-api/docs
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# 4. Perplexity AI API (sonar / sonar-pro with Live Web Citations)
# Docs: https://docs.perplexity.ai/
# -----------------------------------------------------------------
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# -----------------------------------------------------------------
# 5. Anthropic Claude API (claude-3-5-sonnet-20241022 / claude-3-5-haiku)
# Docs: https://docs.anthropic.com/en/api/getting-started
# -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# -----------------------------------------------------------------
# Safe Execution & Budget Controls
# -----------------------------------------------------------------
MAX_SPEND_LIMIT_USD=5.00
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=2
RATE_LIMIT_DELAY_SECONDS=2
