          "groundingSupports": [
            {
              "segment": {
                "startIndex": 407,
                "endIndex": 592,
                "text": "*   **Zoom Cloud Recordings:** Sign in to the Zoom web portal, navigate to \"Recordings,\" select \"Cloud Recordings,\" open the desired recording, and click \"Download\" to get the MP4 file."
              },
              "groundingChunkIndices": [
                0,
                1,
                2
              ]
            },
            {
              "segment": {
                "startIndex": 593,
                "endIndex": 788,
                "text": "*   **Local Recordings:** If you recorded locally, the MP4 file will be in a Zoom folder on your computer, typically in `Documents/Zoom` on Windows or `/Users/[Username]/Documents/Zoom` on a Mac."
              },
              "groundingChunkIndices": [
                3,
                1,
                4
              ]
            },
            {
              "segment": {
                "startIndex": 834,
                "endIndex": 984,
                "text": "A 1-hour recording needs to be condensed into impactful, short clips (ideally 30-90 seconds for awareness content, up to 15 minutes for longer posts)."
              },
              "groundingChunkIndices": [
                5,
                0
              ]
            },
            {
              "segment": {
                "startIndex": 1405,
                "endIndex": 1441,
                "text": "It also provides a \"Virality Score.\""
              },
              "groundingChunkIndices": [
                6,
                7,
                8,
                9,
                10,
                11
              ]
            },
            {
              "segment": {
                "startIndex": 1442,
                "endIndex": 1503,
                "text": "*   **Klap:** An AI clipper that automatically selects clips."
              },
              "groundingChunkIndices": [
                7,
                11
              ]
            },
            {
              "segment": {
                "startIndex": 1504,
                "endIndex": 1666,
                "text": "*   **Vizard:** Offers AI-powered transcription and an editor to repurpose content into viral clips, allowing adjustments to aspect ratio, cropping, and captions."
              },
              "groundingChunkIndices": [
                8,
                12,
                11,
                13
              ]
            },
            {
              "segment": {
                "startIndex": 1667,
                "endIndex": 1791,
                "text": "*   **Descript:** Excellent for turning interviews, webinars, and podcasts into clips by editing the text of the transcript."
              },
              "groundingChunkIndices": [
                14,
                10
              ]
            },
            {
              "segment": {
                "startIndex": 1792,
                "endIndex": 1941,
                "text": "*   **CapCut:** While known for mobile editing, its desktop version offers AI-assisted clipping, auto-captions, and templates for short-form content."
              },
              "groundingChunkIndices": [
                7,
                14,
                15,
                16,
                10
              ]
            },
            {
              "segment": {
                "startIndex": 1942,
                "endIndex": 2070,
                "text": "*   **Pictory:** Upload a long video, podcast, or webinar, and Pictory generates short videos, summaries, clips, and highlights."
              },
              "groundingChunkIndices": [
                17
              ]
            },
            {
              "segment": {
