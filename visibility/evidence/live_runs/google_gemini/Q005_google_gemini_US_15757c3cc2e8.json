              "segment": {
                "startIndex": 460,
                "endIndex": 624,
                "text": "Opus Clip is widely recognized as a leading AI tool for quickly generating short-form video clips from longer content such as podcasts, webinars, and YouTube videos"
              },
              "groundingChunkIndices": [
