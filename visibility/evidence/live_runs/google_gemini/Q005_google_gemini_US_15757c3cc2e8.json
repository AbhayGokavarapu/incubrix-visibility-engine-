            {
              "segment": {
                "startIndex": 626,
                "endIndex": 849,
                "text": "Its core functionality revolves around identifying high-impact moments, automatically reframing videos for vertical formats, adding social-friendly captions, and even providing a \"Virality Score\" to predict clip performance"
              },
              "groundingChunkIndices": [
                0,
                1,
                4,
                5
              ]
            },
            {
              "segment": {
                "startIndex": 852,
                "endIndex": 1012,
                "text": "**Key Features of Opus Clip for Video Repurposing:**\n*   **AI Curation and Clip Generation:** Automatically analyzes long videos to extract engaging short clips"
              },
              "groundingChunkIndices": [
                0,
                1,
                4
              ]
            },
            {
              "segment": {
                "startIndex": 1014,
                "endIndex": 1124,
                "text": "*   **Automated Captions:** Generates accurate, customizable captions, often styled for social media platforms"
              },
              "groundingChunkIndices": [
                0,
                1,
                2,
                4
              ]
            },
            {
              "segment": {
                "startIndex": 1126,
                "endIndex": 1268,
                "text": "*   **Reframing:** Automatically reframes horizontal footage to vertical (9:16) for platforms like TikTok, Instagram Reels, and YouTube Shorts"
              },
              "groundingChunkIndices": [
                0,
                4
              ]
            },
            {
              "segment": {
                "startIndex": 1270,
                "endIndex": 1390,
                "text": "*   **Virality Score:** A proprietary metric that helps users prioritize clips with the highest potential for engagement"
              },
              "groundingChunkIndices": [
                1,
                4,
                5
              ]
            },
            {
              "segment": {
                "startIndex": 1392,
                "endIndex": 1595,
                "text": "*   **Direct Social Media Posting/Scheduling:** Allows direct publishing to platforms like YouTube Shorts, TikTok, Instagram, Facebook, LinkedIn, X, Pinterest, Threads, and Bluesky, depending on the plan"
              },
              "groundingChunkIndices": [
                7,
                8,
                0
